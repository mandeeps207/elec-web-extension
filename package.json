{
  "name": "elec-training-qualification-checker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local development of the Elec Training qualification checker",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:release": "node scripts/build.mjs --release",
    "package": "node scripts/package.mjs --release",
    "package:dev": "node scripts/package.mjs",
    "build:candidate": "node scripts/build.mjs --candidate",
    "package:candidate": "node scripts/package.mjs --candidate",
    "validate:candidate": "node scripts/validate.mjs --candidate --built",
    "validate": "node scripts/validate.mjs",
    "validate:release": "node scripts/validate.mjs --release",
    "test": "node --test tests/*.test.mjs",
    "check:syntax": "node scripts/syntax.mjs",
    "lint": "web-ext lint --source-dir build/development/firefox --warnings-as-errors",
    "test:browser": "node scripts/browser-test.mjs",
    "build:safari": "node scripts/safari.mjs build",
    "validate:safari": "node scripts/safari.mjs validate",
    "package:safari": "node scripts/safari.mjs package",
    "test:apple-ci": "node --test tests/apple-ci.test.mjs",
    "prepare:apple-input": "node scripts/apple-input.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "fflate": "0.8.3",
    "selenium-webdriver": "4.49.0",
    "web-ext": "10.6.0"
  }
}
